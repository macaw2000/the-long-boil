  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "source",
    "applies_to",
    "units",
    "constants",
    "player_formulas",
    "gear",
    "monster_stats_shape",
    "reference_player",
    "weakness",
    "kill_time",
    "rations",
