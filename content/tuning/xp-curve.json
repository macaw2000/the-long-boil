{
 "schema": "tuning.xp_curve/1",
 "id": "tuning.global.xp_curve",
 "revision": 2,
 "source": "docs/work-orders/001-xp-curve.md (revision 2); docs/gdd.md sections 1, 6, 7; docs/targets.md Pacing",
 "applies_to": "all sixteen skills (GDD section 6: 'All sixteen skills share one XP curve; no skill is cheaper to level than another.')",
 "assumptions": {
  "_note": "Assumptions, not canon. The assayer reports these as assumed.",
  "CHECKINS_PER_DAY": 3,
  "ONLINE_MINUTES_PER_CHECKIN": 4,
  "OFFLINE_HOURS_PER_CHECKIN": 12,
  "OFFLINE_HOURS_USED_PER_DAY": 23.8,
  "WORK_HOURS_PER_DAY": 24,
  "BAND_SKILL_QUEUE_HOURS_PER_DAY": 12,
  "MAIN_COMBAT_SKILL_SHARE": 0.7,
  "OTHER_COMBAT_SKILLS_SHARE_EACH": 0.05,
  "MAIN_COMBAT_SKILL_HOURS_EQUIVALENT_PER_DAY": 8.4,
  "REFERENCE_ACTIONS_PER_HOUR": 66.6667,
  "REFERENCE_XP_PER_HOUR": 666.67,
  "BAND_1_RATE_MULTIPLIER": 1.0,
  "DAY2_NONCOMBAT_SKILLS_ROTATED": 3,
  "DAY2_HORIZON_HOURS": 48,
  "GEOMETRIC_RATIO_KEPT_FROM_DRAFT_1": 1.035,
  "XP_UNIT_SCALE_NOTE": "The reference yield of 10 XP sets the unit. Scaling it and every table value by the same factor changes no pacing."
 },
 "formula": {
  "shape": "hybrid: a cheap opening stretch (levels 1 to 5) that ramps up cubically into geometric growth from level 6 on",
  "level_cost": "cost(L -> L+1) = round_half_up(base * ratio^(L-1) * min(1, (L/opening_end)^opening_power)), for L = 1..99",
  "total_xp": "total_xp(L) = sum of cost(k) for k = 1..L-1; total_xp(1) = 0",
  "join": "At L = opening_end the ramp factor reaches 1, so cost(6) is the plain geometric cost and the curve is geometric from there to level 100, uncapped.",
  "constants": {
   "base": 3537,
   "ratio": 1.035,
   "opening_end": 6,
   "opening_power": 3
  },
  "derived": true,
  "_derivation": "base is solved so total_xp(20) = 14 days x 8.4 main-skill hours/day x 666.67 XP/h = 78,400 XP (resolved table gives 78,397 after rounding). ratio is kept from draft 1 (confirmed shape, value is an assumption). opening_end = 6 and opening_power = 3 are chosen so total level passes 50 within 48 hours. With them, day 7 lands at main combat level 13.45, 1.45 levels over section 7's 'about level 12'; that gap is reported in day7_check, not hit."
 },
 "reference_action": {
  "id": "tuning.global.xp_reference_smelt_brass_ingot",
  "action": "smelt one Brass Ingot",
  "skill": "smithing",
  "xp": 10,
  "seconds_per_action": 54,
  "purpose": "Reference value for pacing work only. This is not the first row of an action table. xp = 10 is a unit choice (see assumptions.XP_UNIT_SCALE_NOTE). seconds_per_action = 54 is an inferred upper bound, an assumption, not derived: section 7 gives '400 Brass Ingots smelted' at the 0:00 check-in and 'Nothing in the game needs her for 6 hours' after it; 6 h / 400 = 54 s. The GDD never says the 400 ingots took 6 hours, and that 6-hour queue also held Rust Rat kills, so the true time per ingot is at most 54 s.",
  "derived": false
 },
